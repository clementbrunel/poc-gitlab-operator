# Configuration GitLab
GITLAB_URL=https://gitlab.entreprise.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# GitLab Applications Auto-Sync (optionnel)
# Synchronise automatiquement la liste des applications depuis GitLab
# Format: comma-separated list of group paths
# Examples:
#   GITLAB_GROUPS=team/backend,team/frontend
#   GITLAB_GROUPS=my-organization
GITLAB_GROUPS=
GITLAB_SYNC_BRANCH=develop

# Configuration Administrateur
ADMIN_USERNAME=admin
ADMIN_PASSWORD=VotreMotDePasseSecurise123!

# Configuration SMTP (Email)
SMTP_HOST=smtp.entreprise.com
SMTP_PORT=587
SMTP_USERNAME=user@entreprise.com
SMTP_PASSWORD=password_smtp
SMTP_FROM=noreply@deployment-manager.com

# Configuration Déploiement
DEPLOYMENT_EMAIL=equipe-deploy@entreprise.com

# Configuration Serveur (optionnel)
SERVER_PORT=8080

# Notes:
# - Copiez ce fichier vers .env et remplissez les valeurs
# - Ne committez JAMAIS le fichier .env (déjà dans .gitignore)
# - Le token GitLab doit avoir les permissions: read_api, read_repository
